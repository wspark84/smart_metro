# Copy to .env for Docker Compose or export equivalent environment variables.
# Do not commit .env. Replace every example value before enabling a live provider.

# Public HTTPS URL in a real deployment. Keep the local default only for local testing.
APP_BASE_URL=https://buswakeup.example.com
BUSWAKEUP_PORT=4173
PUSH_GATEWAY_MODE=preview

# Transit and route providers
SEOUL_OPEN_API_KEY=
GYEONGGI_SERVICE_KEY=
TAGO_SERVICE_KEY=
HOLIDAY_API_SERVICE_KEY=
KAKAO_LOCAL_REST_API_KEY=
# General Kakao Maps public-transit REST API; falls back to KAKAO_LOCAL_REST_API_KEY.
KAKAO_TRANSIT_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=
# Public browser key for Kakao Maps JavaScript SDK. It is not interchangeable with the REST key.
KAKAO_JAVASCRIPT_KEY=

# Web sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Keep escaped newlines (\\n) when storing this private key in one .env line.
APPLE_PRIVATE_KEY=

# Firebase Cloud Messaging
# For Docker, use one minified JSON service-account value. Do not point to a host file path.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Only use FCM_ACCESS_TOKEN for a short-lived diagnostic test; service-account JSON is preferred.
FCM_ACCESS_TOKEN=

# Direct APNs signs and refreshes its own short-lived bearer token from this Apple .p8 key.
# APNS_AUTH_TOKEN remains available only for a short-lived diagnostic test.
APNS_BUNDLE_ID=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_AUTH_TOKEN=
APNS_ENV=production

# Transactional account email. Omit all SMTP values to keep local preview mode.
EMAIL_FROM=
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Browser Web Push. Generate one VAPID key pair and keep the private key secret.
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
